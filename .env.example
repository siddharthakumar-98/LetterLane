# Zero-account local development. Never enable local mode on a public deployment.
GAME_BACKEND=local
LOCAL_DATA_DIR=.letterlane/local
# Production: set GAME_BACKEND=supabase and configure all three values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase transaction pooler connection string; server-only, never NEXT_PUBLIC_.
DATABASE_URL=
# Optional direct/session-pooler connection for migrations.
MIGRATION_DATABASE_URL=
# Google AdSense (public identifiers). Production builds default to LetterLane's
# publisher ID; set another ca-pub ID, or off to disable. See docs/advertising.md.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
# Set to 1 only after H5 Games Ads approval (lobby interstitial).
NEXT_PUBLIC_ADSENSE_H5=
# Development only: request test ads.
NEXT_PUBLIC_ADSENSE_TEST=
# Canonical production origin for robots.txt and sitemap.xml, e.g. https://letterlane.example
SITE_URL=
