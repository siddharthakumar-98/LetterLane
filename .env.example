# Zero-account local development. Never enable local mode on a public deployment.
GAME_BACKEND=local
LOCAL_DATA_DIR=.letterlane/local
# Production: set GAME_BACKEND=supabase and configure all three values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase transaction pooler connection string; server-only, never NEXT_PUBLIC_.
DATABASE_URL=
# Optional direct/session-pooler connection for migrations.
MIGRATION_DATABASE_URL=
